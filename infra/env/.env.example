# ─────────────────────────────────────────────
# RWA Credit Data Room — Environment Variables
# Copy to .env and fill in real values
# NEVER commit real secrets to version control
# ─────────────────────────────────────────────

# ── General ───────────────────────────────────
NODE_ENV=development                    # development | test | production
LOG_LEVEL=debug                         # debug | info | warn | error

# ── API Server ────────────────────────────────
API_PORT=3001                           # NestJS API listen port
API_HOST=0.0.0.0                        # API bind address
CORS_ORIGINS=http://localhost:3000      # Comma-separated allowed origins

# ── Frontend ──────────────────────────────────
WEB_PORT=3000                           # Next.js listen port
NEXT_PUBLIC_API_URL=                    # Backend API URL (public, baked into client bundle)

# ── PostgreSQL ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=                          # DB username
POSTGRES_PASSWORD=                      # DB password (SECRET)
POSTGRES_DB=rwa_dataroom
DATABASE_URL=                           # Full connection string: postgresql://user:pass@host:port/db

# ── Redis ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                         # Redis password (SECRET, optional for dev)
REDIS_URL=                              # Full connection string: redis://:pass@host:port

# ── JWT / Auth ────────────────────────────────
JWT_SECRET=                             # Ed25519 private key or HMAC secret (SECRET)
JWT_ACCESS_TTL=900                      # Access token TTL in seconds (default: 15 min)
JWT_REFRESH_TTL=604800                  # Refresh token TTL in seconds (default: 7 days)
CSRF_SECRET=                            # CSRF token signing secret (SECRET)

# ── Sui Blockchain ────────────────────────────
SUI_NETWORK=devnet                      # devnet | testnet | mainnet
SUI_RPC_URL=                            # Sui Full Node RPC URL
SUI_PACKAGE_ID=                         # Deployed Move package object ID
SUI_ADMIN_CAP_ID=                       # AdminCap object ID
NEXT_PUBLIC_SUI_NETWORK=devnet          # Client-side network selector
NEXT_PUBLIC_PACKAGE_ID=                 # Client-side package ID

# ── Sui Sponsored TX ──────────────────────────
SUI_SPONSOR_PRIVATE_KEY=                # Platform sponsor wallet private key (SECRET)
SUI_SPONSOR_ADDRESS=                    # Platform sponsor wallet address

# ── Walrus Storage ────────────────────────────
WALRUS_PUBLISHER_URL=                   # Walrus Publisher endpoint
WALRUS_AGGREGATOR_URL=                  # Walrus Aggregator endpoint
WALRUS_DEFAULT_EPOCHS=5                 # Default blob storage duration in epochs
NEXT_PUBLIC_WALRUS_PUBLISHER_URL=       # Client-side publisher URL
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=      # Client-side aggregator URL

# ── Indexer ───────────────────────────────────
INDEXER_POLL_INTERVAL_MS=1000           # Event polling interval (ms)
INDEXER_HEALTH_PORT=3002                # Indexer health check port

# ── Monitoring (optional) ─────────────────────
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                 # Grafana admin password (SECRET)

# ── AWS (production backup, optional) ─────────
AWS_REGION=ap-southeast-1
AWS_S3_BACKUP_BUCKET=                   # S3 bucket for encrypted blob backups
AWS_ACCESS_KEY_ID=                      # AWS access key (SECRET)
AWS_SECRET_ACCESS_KEY=                  # AWS secret key (SECRET)
